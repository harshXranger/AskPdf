# Google Gemini API key: Get your key from https://aistudio.google.com/apikey
# Supports both classic 'AIza...' keys and new 'AQ...' project keys.
GEMINI_API_KEY=your_gemini_api_key_here

# (Optional fallback) If GEMINI_API_KEY is not defined, GOOGLE_API_KEY will be used:
# GOOGLE_API_KEY=your_gemini_api_key_here

# Preferred Gemini Model (default: gemini-3.8-flash, with automatic dynamic fallback)
GEMINI_MODEL=gemini-3.8-flash

# Maximum document context characters to send to Gemini
MAX_CONTEXT_CHARS=6000

# Server configuration
PORT=5000
FRONTEND_ORIGIN=*

# Optional Ollama configuration (for local fallback)
# ENABLE_OLLAMA_FALLBACK=false
# OLLAMA_API_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1
